{
  "name": "extranet",
  "version": "1.0.0",
  "description": "Share folders from this computer over Wi-Fi or the internet, with a dead-simple viewer for guests.",
  "license": "MIT",
  "main": "server/index.js",
  "bin": {
    "extranet": "bin/cli.js"
  },
  "files": [
    "bin/",
    "server/",
    "public/",
    "README.md"
  ],
  "scripts": {
    "start": "node bin/cli.js",
    "setup": "npm --prefix app install",
    "dev": "npm --prefix app run dev",
    "build": "npm --prefix app run build",
    "smoke": "node app/smoke.mjs"
  },
  "engines": {
    "node": ">=20.17"
  },
  "dependencies": {
    "fastify": "^5.12.7",
    "qrcode": "^1.5.4"
  }
}

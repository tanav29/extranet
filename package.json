{
  "name": "extranet",
  "version": "1.0.0",
  "description": "Share folders and app ports from this computer over Wi-Fi or the internet, with a dead-simple viewer for guests.",
  "license": "MIT",
  "main": "dist/server/index.js",
  "bin": {
    "extranet": "dist/bin/cli.js"
  },
  "files": [
    "dist/bin/",
    "dist/server/",
    "app/dist/",
    "README.md"
  ],
  "scripts": {
    "start": "npm run build:server && node dist/bin/cli.js",
    "setup": "npm ci && npm --prefix app ci",
    "dev": "npm --prefix app run dev",
    "build": "npm run build:server && npm run build:ui",
    "smoke": "npm run build:tools && node app/dist-tools/smoke.js",
    "test": "npm run build:server && node --test dist/test/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm --prefix app run typecheck && tsc -p app/tsconfig.tools.json --noEmit",
    "build:server": "tsc -p tsconfig.json",
    "build:ui": "npm --prefix app run build",
    "prepack": "npm run build",
    "build:tools": "tsc -p app/tsconfig.tools.json"
  },
  "engines": {
    "node": ">=20.17"
  },
  "dependencies": {
    "fastify": "^5.12.7",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "typescript": "^5.9.3"
  }
}
